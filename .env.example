# ---- data ------------------------------------------------------------------
# auto = scrape public APIs, fall back to the calibrated simulator if unreachable
GRIDALPHA_DATA_MODE=auto
GRIDALPHA_HISTORY_START=2023-01-01

# ---- modelling / backtest ----------------------------------------------------
GRIDALPHA_BACKTEST_DAYS=365
GRIDALPHA_RETRAIN_EVERY_DAYS=28
GRIDALPHA_ENABLE_DEEP_MODEL=true

# ---- battery asset -------------------------------------------------------------
GRIDALPHA_BATTERY_POWER_MW=10
GRIDALPHA_BATTERY_ENERGY_MWH=20
GRIDALPHA_BATTERY_RTE=0.88
GRIDALPHA_BATTERY_MAX_CYCLES_PER_DAY=1.5
GRIDALPHA_DEGRADATION_EUR_PER_MWH=8
GRIDALPHA_RISK_AVERSION=0.3

# ---- scheduler (in the API process; docker-compose uses a dedicated service) ---
GRIDALPHA_SCHEDULER_ENABLED=false

# ---- optional LLM copilot (any OpenAI-compatible endpoint) ---------------------
# GRIDALPHA_LLM_BASE_URL=http://localhost:11434/v1     # Ollama
# GRIDALPHA_LLM_MODEL=llama3.1
# GRIDALPHA_LLM_API_KEY=
